{
  "name": "lazy-shopping-list",
  "type": "module",
  "scripts": {
    "vendor": "esbuild scripts/vendor-entries/*.js --bundle --format=esm --splitting --target=es2022 --minify --sourcemap --outdir=public/vendor && node scripts/vendor-theme.mjs",
    "dev": "pnpm vendor && wrangler dev",
    "deploy": "pnpm vendor && wrangler deploy --minify",
    "release": "pnpm vendor && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc -p tsconfig.public.json && tsc -p tsconfig.sw.json",
    "test": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@lazy/theme": "github:michalczukm/lazy-theme#4e03501afe2d0df97eceb3545ba1740f30402e4f",
    "@preact/signals": "1.3.4",
    "canvas-confetti": "1.6.0",
    "hono": "4.12.16",
    "htm": "3.1.1",
    "htmx.org": "2.0.10",
    "preact": "10.29.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.18",
    "@types/canvas-confetti": "^1.6.0",
    "esbuild": "0.28.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "posthog-js": "^1.407.3",
    "typed-htmx": "0.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "wrangler": "4.103.0"
  }
}
