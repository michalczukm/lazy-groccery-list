{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "types": []
  },
  "include": ["public/globals.d.ts", "public/**/*.js"],
  // public/vendor is generated by `pnpm vendor` (third-party dist builds, not ours).
  "exclude": ["public/sw.js", "public/vendor"]
}
